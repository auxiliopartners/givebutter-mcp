{
  "name": "givebutter-mcp",
  "version": "1.0.0",
  "description": "MCP server for Givebutter API - enables AI assistants to manage fundraising campaigns, contacts, and transactions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
